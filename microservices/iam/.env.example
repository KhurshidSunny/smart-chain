PORT=3001
# Set to false when using real MongoDB (Docker or local install)
USE_MEMORY_DB=false
MONGO_URI=mongodb://127.0.0.1:27017/smartchain
JWT_SECRET=smartchain-dev-jwt-secret-use-same-in-all-services
REFRESH_TOKEN_EXPIRY=7d
# Leave false for local HTTP. Set true only when IAM is served over HTTPS.
COOKIE_SECURE=false
# Browser origins allowed to call this API. Defaults to the Vite app when unset.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JSON_BODY_LIMIT=100kb
# Login, register, and refresh: requests per IP in the window.
AUTH_RATE_WINDOW_MS=900000
AUTH_RATE_MAX=30
